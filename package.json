{
  "name": "learning-platform",
  "private": true,
  "type": "module",
  "description": "A shared course platform and the course sites built on it, for Bible translators and consultants.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "platform",
    "site",
    "courses/*"
  ],
  "scripts": {
    "dev:site": "npm run dev -w @cohorts/site",
    "dev:logos": "npm run dev -w @cohorts/logos",
    "dev:tc": "npm run dev -w @cohorts/textual-criticism",
    "dev:exegesis": "npm run dev -w @cohorts/exegesis",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm test -w @cohorts/platform && node --test scripts/*.test.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}

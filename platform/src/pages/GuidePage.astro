---
// A guide page from a Markdown file in src/content/guides/: a book-page header (cover, details, what you
// will learn), contents from its headings, a "not yet checked" notice until checked, and its sources.
// Simplified from the Textual Criticism site's Context layout.
// Course route (src/pages/guides/[id].astro):
//   export const getStaticPaths = guideStaticPaths;
//   <GuidePage site={course} entry={Astro.props.entry} />
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Sources from '../components/Sources.astro';
import Feedback from '../components/Feedback.astro';
import Lightbox from '../components/Lightbox.astro';
import GuideCard from '../components/GuideCard.astro';
import Tags from '../components/Tags.astro';
import Unverified from '../components/Unverified.astro';
import { getGuides, type GuideEntry } from '../data';
import { levelName, type SiteConfig } from '../config';
import { url } from '../url';
import { PATHS } from '../paths';
interface Props { site: SiteConfig; entry: GuideEntry }
const { site, entry } = Astro.props;
const g = entry.data;
const { Content, headings } = await render(entry);
const all = await getGuides();
const byId = (id: string) => all.find((x) => x.data.id === id)?.data;
const before = g.before ? byId(g.before) : undefined;
const related = g.related.map(byId).filter((x) => x !== undefined);
const toc = headings.filter((h) => h.depth === 2);
if (g.sources.length) toc.push({ depth: 2, slug: 'sources', text: 'Sources' });
const PIGMENTS = ['lapis', 'verdigris', 'ochre', 'gall'] as const;
const pig = (level: number) => PIGMENTS[(level - 1) % 4];
---
<Base site={site} title={g.title} description={g.summary} nav={PATHS.guides}>
  <Fragment slot="head"><slot name="head" /></Fragment>
  <section class="book">
    <Cover title={g.cover} kicker="Guide" pigment={pig(g.level)} href="#read" />
    <div class="book-main">
      <p class="label">Guide · {levelName(site, g.level)}{g.draft && ' · draft'}</p>
      <h1>{g.title}</h1>
      <p class="book-lead">{g.summary}</p>
      <Tags tags={g.tags} />
      <dl class="book-spec">
        {before && <><dt>Read first</dt><dd><a href={url(PATHS.guide(before.id))}>{before.cover}</a></dd></>}
        {g.sources.length > 0 && <><dt>Sources</dt><dd>{g.sources.length}{g.sources.some((s) => !s.checked) && ' (some not yet checked)'}</dd></>}
        {g.last_checked && <><dt>Last checked</dt><dd>{g.last_checked}</dd></>}
      </dl>
    </div>
    <aside class="book-learn">
      <h2>What you will learn</h2>
      <ul>{g.learn.map((l) => <li>{l}</li>)}</ul>
    </aside>
  </section>
  <div class:list={['read', { 'has-toc': toc.length > 1 }]} id="read">
    {toc.length > 1 && (
      <nav class="toc" aria-label="On this page">
        <details open>
          <summary class="label">On this page</summary>
          <ol>{toc.map((t) => <li><a href={`#${t.slug}`}>{t.text}</a></li>)}</ol>
        </details>
      </nav>
    )}
    <article class="ctx prose" data-zoomable>
      {!g.checked && (
        <p class="notice"><span class="tag">not yet checked</span> Written from the sources listed at the end, but not yet checked line by line against them. Use it as a guide, not as a source.</p>
      )}
      <Content />
      <Unverified items={g.unverified} />
      <Sources sources={g.sources} lastChecked={g.last_checked} />
      <Feedback site={site} title={g.title} />
    </article>
  </div>
  {related.length > 0 && (
    <section class="sec" id="related">
      <header><h2>Related</h2></header>
      <ul class="guide-cards">
        {related.map((r) => <li><GuideCard site={site} guide={r} /></li>)}
      </ul>
    </section>
  )}
  <Lightbox />
</Base>

<style>
  .book { display: grid; gap: 1.5rem; padding: 1.75rem 0 2rem; border-bottom: 1px solid var(--rule); }
  .book > :global(.cover) { width: 11rem; }
  .book h1 { font-size: clamp(1.8rem, 3.4vw, 2.5rem); margin: 0.2rem 0 0.6rem; }
  .book-lead { font-size: var(--step-1); line-height: 1.45; max-width: 40rem; }
  .book-main :global(.tags) { margin: 0.2rem 0 0.4rem; }
  .book-spec { display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 1rem; margin: 1rem 0; padding: 0.9rem 0; border-block: 1px solid var(--rule); font: 0.875rem/1.45 var(--sans); max-width: 40rem; }
  .book-spec:empty { display: none; }
  .book-spec dt { color: var(--ink-2); }
  .book-spec dd { margin: 0; }
  .book-learn { border: 1px solid var(--rule); border-radius: 8px; padding: 1rem 1.1rem; align-self: start; }
  .book-learn h2 { font: 600 1rem var(--sans); margin: 0 0 0.5rem; }
  .book-learn ul { margin: 0; padding-left: 1.1rem; }
  .book-learn li { margin: 0.3rem 0; }
  @media (min-width: 760px) { .book { grid-template-columns: 13rem minmax(0, 1fr); } .book > :global(.cover) { width: 100%; } .book-learn { grid-column: 2; } }
  @media (min-width: 1150px) { .book { grid-template-columns: 15rem minmax(0, 1fr) 17rem; gap: 2.5rem; } .book-learn { grid-column: auto; } }
  .read { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; padding-top: 1.5rem; }
  .read > * { min-width: 0; }
  .toc { font: 0.9rem/1.45 var(--sans); }
  .toc summary { cursor: pointer; margin: 0; }
  .toc ol { padding-left: 1.2rem; margin: 0.5rem 0 0; }
  .toc li { margin: 0.25rem 0; }
  .toc a { color: var(--ink); text-decoration: none; }
  .toc a:hover { color: var(--accent); text-decoration: underline; }
  @media (max-width: 999px) { .toc { border: 1px solid var(--rule); border-radius: 8px; padding: 0.6rem 0.9rem; } }
  @media (min-width: 1000px) {
    .read.has-toc { grid-template-columns: 15rem minmax(0, 1fr); gap: 3rem; }
    .toc { position: sticky; top: 1rem; align-self: start; max-height: calc(100vh - 2rem); overflow: auto; }
  }
  .ctx :global(:is(h2, h3)[id]) { scroll-margin-top: 1rem; }
  .notice { font-family: var(--sans); font-size: var(--step--1); color: var(--ink-2); border-left: 3px solid var(--rule); padding-left: 0.6rem; }
</style>

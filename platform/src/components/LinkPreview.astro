---
// Link previews: point at (or focus) a link to another page of the Hub and a small card shows that page's
// title and summary, with "Open page" and "Open in a new tab". On a touch screen the first tap shows the card
// and a second tap on the link opens the page. The data is previews.json, written at build time for each site
// (integrations/previews.mjs). Without JavaScript, or when a page has no preview, links work as usual.
// A link opts out with data-no-preview (on it or an ancestor). Links in headings and menus are skipped:
// their summary is usually already beside them.
---
<script>
  type Entry = { t: string; d: string; in?: string };
  type Hit = { e: Entry; site: string };
  const root = document.documentElement;
  const base = root.dataset.base || '/';
  const hub = root.dataset.hub || '/';
  const cache = new Map<string, Promise<Record<string, Entry>>>();
  const loaded = new Map<string, Record<string, Entry>>();
  const load = (r: string) => {
    if (!cache.has(r)) {
      cache.set(r, fetch(r + 'previews.json').then((x) => (x.ok ? x.json() : {})).catch(() => ({})).then((d) => { loaded.set(r, d); return d; }));
    }
    return cache.get(r)!;
  };
  const SKIP = 'h1 a, h2 a, h3 a, h4 a, nav a, [data-no-preview], [data-no-preview] a';

  // The site roots a path may belong to, most specific first: this site, a course under the Hub, the Hub.
  function roots(path: string) {
    const r: string[] = [];
    if (path.startsWith(base)) r.push(base);
    if (path.startsWith(hub)) {
      const seg = path.slice(hub.length).split('/')[0];
      if (seg && !r.includes(hub + seg + '/')) r.push(hub + seg + '/');
      if (!r.includes(hub)) r.push(hub);
    }
    return r;
  }
  function target(a: HTMLAnchorElement) {
    if (a.matches(SKIP) || a.target === '_blank' || a.hasAttribute('download')) return null;
    const u = new URL(a.href, location.href);
    if (u.origin !== location.origin) return null;
    // Not links within this page (contents lists), nor filtered views like guides/?tag=…
    if (u.pathname === location.pathname || u.search) return null;
    return u;
  }
  function lookup(u: URL, r: string, data: Record<string, Entry>): Hit | null {
    const path = u.pathname.slice(r.length);
    const e = data[path + u.hash] ?? data[path];
    return e ? { e, site: r === base ? '' : (data['']?.t ?? '') } : null;
  }
  async function find(u: URL) {
    for (const r of roots(u.pathname)) {
      const hit = lookup(u, r, await load(r));
      if (hit) return hit;
    }
    return null;
  }
  // For touch taps, which must decide at once: only data already fetched. undefined = not fetched yet.
  function findNow(u: URL): Hit | null | undefined {
    for (const r of roots(u.pathname)) {
      const data = loaded.get(r);
      if (!data) return undefined;
      const hit = lookup(u, r, data);
      if (hit) return hit;
    }
    return null;
  }

  const card = document.createElement('div');
  card.id = 'lp';
  card.setAttribute('role', 'dialog');
  card.setAttribute('aria-label', 'Link preview');
  card.hidden = true;
  card.innerHTML = '<p class="lp-site"></p><p class="lp-t"></p><p class="lp-d"></p>'
    + '<p class="lp-act"><a class="lp-open">Open page</a><a class="lp-tab" target="_blank" rel="noopener">Open in a new tab<span class="visually-hidden"> (opens in a new tab)</span></a>'
    + '<button type="button" class="lp-x" aria-label="Close preview">×</button></p>';
  document.body.append(card);
  const $ = (s: string) => card.querySelector(s) as HTMLElement;
  let current: HTMLAnchorElement | null = null;
  let showT = 0, hideT = 0;

  function fill(a: HTMLAnchorElement, h: Hit) {
    const where = [h.site, h.e.in].filter((s) => s && s !== h.e.t).join(' · ');
    $('.lp-site').textContent = where;
    $('.lp-site').hidden = !where;
    $('.lp-t').textContent = h.e.t;
    $('.lp-d').textContent = h.e.d;
    $('.lp-d').hidden = !h.e.d;
    (card.querySelector('.lp-open') as HTMLAnchorElement).href = a.href;
    (card.querySelector('.lp-tab') as HTMLAnchorElement).href = a.href;
  }
  function place(a: HTMLAnchorElement, sheet: boolean) {
    card.classList.toggle('lp-sheet', sheet);
    card.style.left = card.style.top = '';
    if (sheet) return;
    const r = a.getClientRects()[0] ?? a.getBoundingClientRect();
    const w = card.offsetWidth, h = card.offsetHeight, pad = 8;
    const left = Math.min(Math.max(pad, r.left), innerWidth - w - pad);
    let top = r.bottom + 6;
    if (top + h > innerHeight - pad && r.top - h - 6 > pad) top = r.top - h - 6;
    card.style.left = left + scrollX + 'px';
    card.style.top = top + scrollY + 'px';
  }
  function show(a: HTMLAnchorElement, h: Hit, sheet = false) {
    clearTimeout(hideT);
    current = a;
    fill(a, h);
    card.hidden = false;
    place(a, sheet);
  }
  function hide() { card.hidden = true; current = null; }
  const hideSoon = () => { clearTimeout(showT); hideT = window.setTimeout(hide, 300); };
  const linkOf = (n: EventTarget | null) => ((n as Element)?.closest?.('main a[href]') as HTMLAnchorElement | null) ?? null;

  // Mouse: show after a short pause on the link; the card stays while the pointer is on the link or the card.
  document.addEventListener('pointerover', (ev) => {
    if (ev.pointerType !== 'mouse') return;
    if (card.contains(ev.target as Node)) { clearTimeout(hideT); return; }
    const a = linkOf(ev.target);
    if (!a) return;
    const u = target(a);
    if (!u) return;
    clearTimeout(showT); clearTimeout(hideT);
    showT = window.setTimeout(async () => { const h = await find(u); if (h) show(a, h); }, 450);
  });
  document.addEventListener('pointerout', (ev) => {
    if (ev.pointerType !== 'mouse') return;
    const to = ev.relatedTarget as Node | null;
    const fromLink = linkOf(ev.target);
    if (!fromLink && !card.contains(ev.target as Node)) return;
    if (to && (card.contains(to) || (current && current.contains(to)))) return;
    hideSoon();
  });
  // Keyboard: the same on focus, when focus came from the keyboard.
  document.addEventListener('focusin', (ev) => {
    if (card.contains(ev.target as Node)) { clearTimeout(hideT); return; }
    const a = linkOf(ev.target);
    if (!card.hidden && !card.classList.contains('lp-sheet') && a !== current) hideSoon();
    if (!a || !a.matches(':focus-visible')) return;
    const u = target(a);
    if (!u) return;
    clearTimeout(showT);
    showT = window.setTimeout(async () => { const h = await find(u); if (h && document.activeElement === a) show(a, h); }, 450);
  });
  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape' || card.hidden) return;
    const a = current, inside = card.contains(document.activeElement);
    hide();
    if (inside) a?.focus();
  });
  $('.lp-x').addEventListener('click', () => { const a = current; hide(); a?.focus({ preventScroll: true }); });

  // Touch: the first tap on a link with a preview shows it as a sheet at the bottom; a second tap opens the page.
  let touch = false;
  document.addEventListener('pointerdown', (ev) => {
    touch = ev.pointerType === 'touch' || ev.pointerType === 'pen';
    if (touch) { const a = linkOf(ev.target); if (a) { const u = target(a); if (u) roots(u.pathname).forEach(load); } }
  }, { capture: true });
  document.addEventListener('click', (ev) => {
    if (!touch) return;
    const a = linkOf(ev.target);
    if (!card.hidden && !card.contains(ev.target as Node) && a !== current) hide();
    if (!a || ev.defaultPrevented || ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
    if (a === current && !card.hidden) return; // second tap: follow the link
    const u = target(a);
    if (!u) return;
    const h = findNow(u);
    if (!h) return; // no preview, or its data has not arrived yet: follow the link
    ev.preventDefault();
    show(a, h, true);
  });
  window.addEventListener('scroll', () => { if (!card.hidden && !card.classList.contains('lp-sheet')) hide(); }, { passive: true });
  // Fetch this site's previews when the browser is idle, so the first preview is quick.
  const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 1500));
  idle(() => load(base));
</script>

<style is:global>
  #lp { position: absolute; z-index: 50; width: min(22rem, calc(100vw - 16px)); box-sizing: border-box; padding: .8rem .95rem .7rem; background: var(--paper); color: var(--ink); border: 1px solid var(--rule); border-top: 3px solid var(--accent); border-radius: 10px; box-shadow: 0 8px 28px rgb(0 0 0 / .18); font: .92rem/1.45 var(--sans); }
  #lp[hidden] { display: none; }
  #lp p { margin: 0; }
  #lp p[hidden] { display: none; }
  #lp .lp-site { font: 600 .7rem/1.3 var(--sans); letter-spacing: .06em; text-transform: uppercase; color: var(--accent); margin-bottom: .25rem; }
  #lp .lp-t { font: 600 1.05rem/1.3 var(--serif); }
  #lp .lp-d { margin-top: .35rem; color: var(--ink-2); }
  #lp .lp-act { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem 1rem; margin-top: .6rem; padding-top: .5rem; border-top: 1px solid var(--rule); font-size: .85rem; }
  #lp .lp-act a { color: var(--accent); font-weight: 600; }
  #lp .lp-x { margin-left: auto; background: none; border: 0; color: var(--ink-2); font-size: 1.3rem; line-height: 1; padding: .1rem .35rem; cursor: pointer; }
  #lp.lp-sheet { position: fixed; left: 8px; right: 8px; bottom: 8px; top: auto; width: auto; padding-bottom: max(.7rem, env(safe-area-inset-bottom)); }
  #lp.lp-sheet .lp-act { gap: .5rem 1.25rem; font-size: .95rem; }
  #lp.lp-sheet .lp-act a { padding: .4rem 0; }
  @media print { #lp { display: none !important; } }
</style>

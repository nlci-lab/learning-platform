---
// Numbered source list (targets for <Cite>). Unchecked sources are marked.
import { mdInline } from '../markdown';
// idPrefix keeps ids unique when a page has more than one list (e.g. a guide's and a decision tree's).
interface Props { sources: { id: string; cite: string; url?: string; checked: boolean }[]; lastChecked?: string; title?: string; idPrefix?: string }
const { sources, lastChecked, title = 'Sources', idPrefix = '' } = Astro.props;
---
{sources.length > 0 && (
  <section class="sources">
    <h2 id={`${idPrefix}sources`}>{title}</h2>
    <ol>
      {sources.map((s, i) => (
        <li id={`${idPrefix}src-n${i + 1}`}>
          <Fragment set:html={mdInline(s.cite)} />{s.url && <> <a href={s.url}>Link</a></>}
          {!s.checked && <span class="tag">not yet checked</span>}
        </li>
      ))}
    </ol>
    {lastChecked && <p class="small muted">Last checked {lastChecked}.</p>}
  </section>
)}

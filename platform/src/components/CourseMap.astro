---
// A course map: the course's units in order, each with its level, topics and status.
// A unit with `href` is ready and links to where it starts; one without is in preparation.
// `ready` lists the guides of a unit that are ready, when only some are (links within the course).
// `also` points to a related page in another course (a path under the Learning Hub).
import { url, hubUrl } from '../url';
export type MapUnit = { level: string; title: string; topics: string; href?: string; ready?: { label: string; path: string }[]; also?: { label: string; path: string } };
interface Props { units: MapUnit[]; heading?: string; intro?: string }
const { units, heading = 'Course map', intro } = Astro.props;
---
<section class="map" id="map" aria-labelledby="map-h">
  <h2 id="map-h">{heading}</h2>
  {intro && <p class="muted">{intro}</p>}
  <ol class="units">
    {units.map((u) => (
      <li class={u.href ? 'ready' : 'soon'}>
        <span class="lvl">{u.level}</span>
        <span class="ttl">{u.href ? <a href={url(u.href)}>{u.title}</a> : u.title}</span>
        <span class="tp">{u.topics}{u.ready && u.ready.length > 0 && <> Ready so far: {u.ready.map((r, i) => <>{i > 0 && ', '}<a href={url(r.path)}>{r.label}</a></>)}. The rest is in preparation.</>}{u.also && <> See also: <a href={hubUrl(u.also.path)}>{u.also.label}</a>.</>}</span>
        <span class="st">{u.href ? 'Ready' : 'In preparation'}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .map { margin: 2.5rem 0; max-width: 46rem; }
  .units { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: .6rem; counter-reset: u; }
  .units li { counter-increment: u; display: grid; grid-template-columns: 2rem minmax(0, 1fr); column-gap: .75rem; row-gap: .15rem; padding: .8rem 1rem; border: 1px solid var(--rule); border-radius: 10px; background: var(--paper); }
  .units li::before { content: counter(u); grid-row: span 4; font: 700 1.3rem var(--serif); color: var(--accent); }
  .lvl { font: 600 .75rem var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .ttl { font: 600 1.1rem/1.3 var(--serif); }
  .tp { font-size: .95rem; color: var(--ink-2); }
  .st { font: 600 .78rem var(--sans); color: var(--ink-2); }
  .units li.ready { border-left: 4px solid var(--accent); }
  .units li.soon .ttl { color: var(--ink-2); }
</style>

---
// One question from content data (ADR 0003, 0004). Renders every Moodle-importable type.
// Without JavaScript: the reader sees the question and a "Show the answer" box with every answer and its feedback.
// With JavaScript: the reader answers, presses Check, and sees the feedback for their own answer.
// Fires a bubbling 'q:checked' event when checked, so a micro module can open its next step.
import type { Question } from '../schemas';
import { md, mdInline } from '../markdown';
interface Props { q: Question }
const { q } = Astro.props;
const name = `q-${q.id}`;

// True/false is a two-option choice; both share one renderer.
type Opt = { text: string; correct: boolean; feedback: string };
const choice: { opts: Opt[]; single: boolean } | null =
  q.type === 'multichoice' ? { opts: q.options, single: q.single }
  : q.type === 'truefalse' ? { single: true, opts: [
      { text: 'True', correct: q.answer, feedback: q.if_true },
      { text: 'False', correct: !q.answer, feedback: q.if_false },
    ] }
  : null;
// Shuffle at build time with a seed from the id, so the order is stable between builds.
if (choice && q.type === 'multichoice' && q.shuffle) {
  let h = [...q.id].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
  const rnd = () => ((h = (h * 1103515245 + 12345) >>> 0) / 2 ** 32);
  choice.opts = [...choice.opts].sort(() => rnd() - 0.5);
}
const matches = q.type === 'matching' ? [...new Set([...q.pairs.map((p) => p.match), ...q.distractors])].sort((a, b) => a.localeCompare(b)) : [];
const short = q.type === 'shortanswer'
  ? JSON.stringify({ cs: q.case_sensitive, a: q.answers.map((a) => ({ t: a.text, f: mdInline(a.feedback ?? '') })), w: mdInline(q.if_wrong) })
  : undefined;
const checkLabel = q.type === 'essay' ? 'Show a model answer' : 'Check my answer';
---
<fieldset class="q" data-q data-type={choice ? 'choice' : q.type} data-short={short} id={name}>
  <legend class="q-prompt" set:html={mdInline(q.prompt)} />

  {choice && (
    <div class="q-opts">
      {choice.opts.map((o, i) => (
        <label class="q-opt" data-correct={o.correct ? '1' : undefined}>
          <input type={choice.single ? 'radio' : 'checkbox'} name={name} value={String(i)} />
          <span set:html={mdInline(o.text)} />
          <span class="q-why" hidden set:html={mdInline(o.feedback)} />
        </label>
      ))}
    </div>
  )}

  {q.type === 'shortanswer' && (
    <div class="q-short">
      <label class="visually-hidden" for={`${name}-a`}>Your answer</label>
      <input id={`${name}-a`} type="text" autocomplete="off" spellcheck="false" />
      <p class="q-fb" hidden></p>
    </div>
  )}

  {q.type === 'matching' && (
    <ol class="q-match">
      {q.pairs.map((p, i) => (
        <li>
          <label for={`${name}-${i}`} set:html={mdInline(p.item)} />
          <span class="q-pick">
            <select id={`${name}-${i}`} data-answer={p.match}>
              <option value="">Choose…</option>
              {matches.map((m) => <option value={m}>{m}</option>)}
            </select>
            <span class="q-fix" hidden>Right match: {p.match}</span>
          </span>
        </li>
      ))}
    </ol>
  )}

  {q.type === 'essay' && (
    <div class="q-essay">
      <label class="visually-hidden" for={`${name}-a`}>Your answer</label>
      <textarea id={`${name}-a`} rows="5" placeholder="Write your answer here. It stays on this page; nothing is sent."></textarea>
    </div>
  )}

  {(q.type === 'shortanswer' || q.type === 'essay') && (
    <div class="q-model" hidden>
      <p class="label">{q.type === 'essay' ? 'A good answer' : 'Answer'}</p>
      <div set:html={q.type === 'essay' ? md(q.model_answer) : mdInline(q.answers[0].text)} />
    </div>
  )}

  <div class="q-act" hidden>
    <button type="button" class="btn primary q-check" disabled={q.type !== 'essay'}>{checkLabel}</button>
    <p class="q-result" role="status" aria-live="polite"></p>
  </div>
  {q.general_feedback && <div class="q-general" hidden set:html={md(q.general_feedback)} />}

  <details class="q-all">
    <summary>Show the answer</summary>
    {choice && (
      <ul>{choice.opts.map((o) => <li><strong>{o.correct ? 'Yes' : 'No'}:</strong> <span set:html={mdInline(o.text)} /> <span class="muted" set:html={mdInline(o.feedback)} /></li>)}</ul>
    )}
    {q.type === 'shortanswer' && (
      <ul>{q.answers.map((a) => <li><strong set:html={mdInline(a.text)} />{a.feedback && <> <span class="muted" set:html={mdInline(a.feedback)} /></>}</li>)}</ul>
    )}
    {q.type === 'matching' && (
      <ul>{q.pairs.map((p) => <li><span set:html={mdInline(p.item)} />: <strong>{p.match}</strong></li>)}</ul>
    )}
    {q.type === 'essay' && <div set:html={md(q.model_answer)} />}
    {q.general_feedback && <div set:html={md(q.general_feedback)} />}
  </details>
</fieldset>

<script>
  const norm = (s: string, cs: boolean) => { const t = s.normalize('NFC').trim().replace(/\s+/g, ' '); return cs ? t : t.toLocaleLowerCase(); };

  document.querySelectorAll<HTMLElement>('[data-q]').forEach((q) => {
    q.classList.add('js');
    const act = q.querySelector<HTMLElement>('.q-act')!;
    const btn = q.querySelector<HTMLButtonElement>('.q-check')!;
    const res = q.querySelector<HTMLElement>('.q-result')!;
    const general = q.querySelector<HTMLElement>('.q-general');
    const model = q.querySelector<HTMLElement>('.q-model');
    const type = q.dataset.type;
    act.hidden = false;
    q.addEventListener('input', () => { btn.disabled = false; });
    q.addEventListener('change', () => { btn.disabled = false; });

    function check(): string | null {
      if (type === 'choice') {
        const opts = [...q.querySelectorAll<HTMLElement>('.q-opt')];
        const isOn = (o: HTMLElement) => o.querySelector('input')!.checked;
        if (!opts.some(isOn)) return null;
        const multi = opts[0].querySelector('input')!.type === 'checkbox';
        opts.forEach((o) => {
          const right = !!o.dataset.correct;
          o.classList.toggle('right', right);
          o.classList.toggle('wrong', isOn(o) && !right);
          o.querySelector<HTMLElement>('.q-why')!.hidden = !(isOn(o) || right);
        });
        const ok = opts.every((o) => isOn(o) === !!o.dataset.correct);
        return ok ? 'Yes, that is right.' : multi ? 'Not quite. The right answers are marked.' : 'Not quite. The right answer is marked.';
      }
      if (type === 'shortanswer') {
        const d = JSON.parse(q.dataset.short!) as { cs: boolean; a: { t: string; f: string }[]; w: string };
        const given = q.querySelector<HTMLInputElement>('.q-short input')!.value;
        if (!given.trim()) return null;
        const hit = d.a.find((a) => norm(a.t, d.cs) === norm(given, d.cs));
        const fb = q.querySelector<HTMLElement>('.q-fb')!;
        fb.innerHTML = hit ? hit.f : d.w;   // our own content, rendered at build time
        fb.hidden = !fb.innerHTML;
        if (model) model.hidden = false;
        return hit ? 'Yes, that is right.' : 'Not quite. Compare your answer with the one below.';
      }
      if (type === 'matching') {
        const sels = [...q.querySelectorAll<HTMLSelectElement>('select')];
        if (!sels.some((s) => s.value)) return null;
        let n = 0;
        sels.forEach((s) => {
          const ok = s.value === s.dataset.answer;
          if (ok) n++;
          s.closest('li')!.classList.toggle('right', ok);
          s.closest('li')!.classList.toggle('wrong', !ok);
          s.parentElement!.querySelector<HTMLElement>('.q-fix')!.hidden = ok;
        });
        return n === sels.length ? 'Yes, all are right.' : `${n} of ${sels.length} right. The right matches are shown.`;
      }
      if (type === 'essay') {
        if (model) model.hidden = false;
        return 'Compare your answer with this one.';
      }
      return null;
    }

    btn.addEventListener('click', () => {
      const msg = check();
      if (msg === null) return;
      res.textContent = msg;
      if (general) general.hidden = false;
      q.dispatchEvent(new CustomEvent('q:checked', { bubbles: true }));
    });
  });
</script>

<style>
  .q { border: 1.5px solid var(--ink); border-radius: 10px; padding: 1rem 1.1rem; margin: 1rem 0; background: var(--paper); min-width: 0; }
  .q-prompt { font: 600 1.05rem/1.4 var(--serif); padding: 0 .3rem; }
  .q-opts { display: grid; gap: .5rem; margin: .5rem 0 .75rem; }
  .q-opt { display: grid; grid-template-columns: auto 1fr; gap: .25rem .6rem; align-items: baseline; padding: .6rem .8rem; border: 1px solid var(--rule); border-radius: 8px; cursor: pointer; }
  .q-opt input { accent-color: var(--accent); }
  .q-opt:has(input:checked) { border-color: var(--ink); background: var(--paper-2); }
  .q-why { grid-column: 2; font: .9rem/1.45 var(--sans); }
  .q-why[hidden], .q-fb[hidden], .q-fix[hidden], .q-model[hidden], .q-general[hidden] { display: none; }
  :is(.q-opt, .q-match li).right { border-color: var(--ok); box-shadow: inset 4px 0 0 var(--ok); }
  :is(.q-opt, .q-match li).wrong { border-color: var(--accent); box-shadow: inset 4px 0 0 var(--accent); }
  .q-short input, .q-essay textarea, .q-match select { font: 1rem var(--serif); color: var(--ink); background: var(--paper); border: 1px solid var(--ink-2); border-radius: 8px; padding: .5rem .6rem; }
  .q-short input, .q-essay textarea { width: 100%; margin: .5rem 0 .75rem; }
  .q-fb { font: .9rem/1.45 var(--sans); margin: -.25rem 0 .75rem; }
  .q-match { list-style: none; padding: 0; margin: .5rem 0 .75rem; display: grid; gap: .5rem; }
  .q-match li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(10rem, 16rem); gap: .4rem 1rem; align-items: center; padding: .5rem .8rem; border: 1px solid var(--rule); border-radius: 8px; }
  @media (max-width: 34rem) { .q-match li { grid-template-columns: 1fr; } }
  .q-pick { display: grid; gap: .25rem; }
  .q-pick select { width: 100%; }
  .q-fix { font: .85rem var(--sans); color: var(--ink-2); }
  .q-model, .q-general { font: .95rem/1.5 var(--sans); margin: .25rem 0 .75rem; padding: .6rem .8rem; border-left: 3px solid var(--ok); background: var(--paper-2); border-radius: 0 6px 6px 0; }
  .q-model :global(p:last-child), .q-general :global(p:last-child) { margin-bottom: 0; }
  .q-act { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; }
  .q-act[hidden] { display: none; }
  .q-result { margin: 0; font: 600 .9rem var(--sans); }
  .q-all { margin-top: .5rem; font: .9rem/1.5 var(--sans); }
  .q-all summary { cursor: pointer; }
  .q-all ul { padding-left: 1.1rem; }
  .q.js .q-all { display: none; }
</style>

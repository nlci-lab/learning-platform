---
import Base from '@cohorts/platform/layouts/Base.astro';
import { url } from '@cohorts/platform/url';
import { site, courses } from '../site.config';
---
<Base site={site} title={site.title}>
  <h1>{site.title}</h1>
  <p>{site.description}</p>
  <ul>
    {courses.map((c) => (
      <li>
        {c.built ? <a href={url(`${c.id}/`)}><strong>{c.title}</strong></a> : <strong>{c.title}</strong>}: {c.blurb} <em>({c.status})</em>
      </li>
    ))}
  </ul>
</Base>

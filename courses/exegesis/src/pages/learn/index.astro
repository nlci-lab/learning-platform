---
import LearnPage from '@cohorts/platform/pages/LearnPage.astro';
import { url } from '@cohorts/platform/url';
import { course } from '../../course.config';
import CourseMap from '@cohorts/platform/components/CourseMap.astro';
import { COURSE_MAP } from '../../data/course-map';
---
<LearnPage site={course} heading="Learn exegesis for checking" intro="Short guides, then guided problems and checking cases where you practise what the guides explain. The first unit ready is on passages that can mean more than one thing; the course map below shows the rest.">
  <section class="sec" id="session">
    <header><h2>Practice session</h2></header>
    <p class="muted">Rehearse a checking session: choose what to say to the team, and see how they respond. <a href={url('learn/checking-session/')}>A checking session: Luke 2:49</a></p>
  </section>
  <CourseMap units={COURSE_MAP} intro="Exegesis works at every level, from a single word to a whole passage. Each level is one unit." />
</LearnPage>

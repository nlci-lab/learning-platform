const sources = [
  { cite: 'UBS Greek New Testament, 5th ed., apparatus at John 1:18, as shown in Paratext 9 (seen 19 Nov 2026).', checked: true },
  { cite: 'UBS Greek New Testament, 5th ed., Introduction pp. 58*–63*, list of symbols, as given in Paratext 9 help: the marks gr and lat with a church father, "it" for the Old Latin (Itala) version, and fractions such as 2/4.', checked: true },

const sources = [
  { cite: 'Bruce M. Metzger and Bart D. Ehrman, The Text of the New Testament, 4th ed. (Oxford University Press, 2005): Erasmus 1516, pp. 142–3; Stephanus 1550 and 1551, p. 150; the Elzevir edition of 1633, the name Textus Receptus and the King James Version, p. 152; Tischendorf, p. 172; Westcott and Hort, p. 174; Nestle 1898, p. 190; the first UBS edition, 1966, p. 192; editions of the Majority text, p. 219.', checked: true },

---
// TC workbench: one textual issue at a time, in the six steps of the worked examples.
// Saves in the browser and downloads one self-contained JSON file per issue.
// File format: scripts/workbench-json.md. Works offline after one visit (public/workbench/sw.js).
// Field names here are the JSON paths; change them only together with that document.
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

const g = (p: string) => url(p);
const ex = (n: number, slug: string) => url(`guide/examples/john-1-18/#step-${n}-${slug}`);

// Step 3: the six questions from "Weighing the evidence", in its order and words.
const EXTERNAL = [
  ['age', 'How old?', 'Look at the earliest witness for each reading.'],
  ['place', 'From where?', 'Which group of manuscripts does each witness belong to?'],
  ['care', 'How careful?', 'Were the witnesses copied carefully?'],
  ['spread', 'How widespread?', 'Do witnesses from different places agree?'],
  ['independent', 'Independent?', 'Or was one copied from another?'],
  ['number', 'How many?', 'This comes last.'],
];
// Step 4: the two questions and the rules of thumb, from the same guide.
const INTERNAL = [
  ['scribe', 'What was a scribe likely to do?', 'Slips of eye and hand; explaining hard wording, smoothing grammar, making passages match.'],
  ['author', 'What was the author likely to write?', "Does the reading fit this writer's words, style and thought?"],
];
const RULES = [
  ['explains', 'Prefer the reading that best explains the others'],
  ['harder', 'The harder reading'],
  ['shorter', 'The shorter reading (never use alone)'],
  ['harmonization', 'Harmonization'],
  ['style', "The author's style"],
];
// Step 2: places to look (the user's list for this workbench).
const SOURCES = [
  ['translations', 'Other translations', 'Paratext: Text Collection. Logos: Text Comparison.'],
  ['commentaries', 'Commentaries', "Paratext: UBS Handbook, Translator's Notes. Logos: search for “textual criticism”."],
  ['net', 'NET Bible notes', 'The translators’ notes often discuss the variant.'],
  ['apparatus', 'UBS apparatus', 'Paratext: Source Language Tools; words with variants have a red caller. Logos: Metzger or Omanson.'],
  ['cntr', 'CNTR collation', 'greekcntr.org/collation: the collation, then each witness’s transcription, then the page image.'],
];
// Step 6: the action kinds of the worked examples (DecideStep).
const ACTIONS = [
  ['footnote', 'Footnote'], ['brackets', 'Brackets'], ['wording', 'Wording'], ['committee', 'Review Committee'],
  ['consult', 'Consult'], ['record', 'Record it'], ['none', 'Not needed'],
];
const favours = (name: string, q: string) =>
  `<select name="${name}" data-favours aria-label="${q} Which reading it favours"><option value="">Favours…</option><option value="even">Even</option><option value="unclear">Unclear</option></select>`;
---
<Base title="Workbench" nav="workbench/" selfContained description="Work through one textual problem step by step, keep your findings, and download them as a file.">
  <div class="wb">
    <header class="wb-head">
      <p class="label">Workbench</p>
      <h1>Work through a textual problem</h1>
      <p class="muted">Bring one doubtful passage. Go through <a href={g('guide/six-steps/')}>the six steps</a> the <a href={g('guide/examples/')}>worked examples</a> use, and at the end you have a decision to record. Your work is saved in this browser as you type. Download it to keep it or to send it to someone.</p>
    </header>

    <div class="bar no-print" role="toolbar" aria-label="File">
      <button type="button" id="wb-download" class="primary">Download file</button>
      <label class="btn">Open a file<input type="file" id="wb-open" accept=".json,application/json" class="visually-hidden" /></label>
      <button type="button" id="wb-print">Print</button>
      <button type="button" id="wb-new">New issue</button>
      <p class="status small muted" id="wb-status" role="status" aria-live="polite"></p>
    </div>
    <noscript><p class="warn">The workbench needs JavaScript to save your work. You can still print the empty form.</p></noscript>

    <form id="wb" autocomplete="off" spellcheck="false">
      <details class="card about" id="about" open>
        <summary><h2>About this work <span class="small muted">(optional)</span></h2></summary>
        <p class="small muted">Saved with every issue, so each file says whose work it is.</p>
        <div class="grid">
          <label>Your name<input name="about.name" dir="auto" /></label>
          <label>Bible or translation you are comparing<input name="about.bible" dir="auto" placeholder="e.g. your draft, or a Bible your readers use" /></label>
          <label>Its language<input name="about.language" dir="auto" /></label>
          <label>Its base text<input name="about.baseText" dir="auto" placeholder="e.g. UBS5, Textus Receptus" /></label>
        </div>
      </details>

      <section class="step" id="s1">
        <span class="n">Step 1</span>
        <h2>Find the problem</h2>
        <p class="ask">What exactly differs between the manuscripts?</p>
        <div class="grid">
          <label>Reference<input name="issue.reference" required dir="auto" placeholder="e.g. John 1:18" /></label>
          <label>Kind of variant
            <select name="issue.kind">
              <option value="">Choose…</option>
              <option value="spelling">Spelling</option>
              <option value="small-words">Small words</option>
              <option value="meaning">Change of meaning</option>
              <option value="long-passage">Long passage</option>
            </select>
          </label>
          <label>Does it change the meaning in your language?
            <select name="issue.changesMeaning">
              <option value="">Choose…</option><option value="yes">Yes</option><option value="no">No</option><option value="unsure">Not sure</option>
            </select>
          </label>
          <label>UBS rating
            <select name="issue.ubsRating">
              <option value="">Choose…</option>
              <option value="A">{'{A}'} certain</option>
              <option value="B">{'{B}'} almost certain</option>
              <option value="C">{'{C}'} difficulty deciding</option>
              <option value="D">{'{D}'} great difficulty</option>
              <option value="diamond">♦ no decision possible</option>
              <option value="none">Not in the UBS apparatus</option>
            </select>
          </label>
        </div>
        <label>The problem in your own words<textarea name="issue.problem" rows="3" dir="auto" placeholder="What is different, and how did you notice it?"></textarea></label>
        <p class="see small">See: <a href={g('guide/which-variants-matter/')}>Which variants matter</a> · <a href={g('guide/decision-tree/')}>Decision tree</a> · <a href={g('guide/apparatus/')}>Reading an apparatus entry</a> · <a href={ex(1, 'find-the-problem')}>Example: John 1:18</a> · Practise: <a href={g('practice/mark-1-2/#step-find')}>Mark 1:2</a>, <a href={g('practice/1-john-5-7/#step-find')}>1 John 5:7–8</a></p>
      </section>

      <section class="step" id="s2">
        <span class="n">Step 2</span>
        <h2>List the readings</h2>
        <p class="ask">Which readings are there, and who supports each one?</p>
        <fieldset class="sources">
          <legend>Where did you look?</legend>
          {SOURCES.map(([k, l, h]) => (
            <label class="check"><input type="checkbox" name={`issue.sources.${k}`} /><span><b>{l}</b> <span class="small muted">{h}</span></span></label>
          ))}
          <p class="small muted">In Paratext, a red number after a Greek word is a textual apparatus entry. A letter or * is not about variants: see <a href={g('guide/paratext/')}>The apparatus in Paratext</a>.</p>
        </fieldset>
        <ol class="readings" id="readings"></ol>
        <button type="button" id="add-reading" class="no-print">Add a reading</button>
        <label>Notes from your sources<textarea name="issue.sourceNotes" data-sigla rows="3" dir="auto"></textarea></label>
        <p class="see small">See: <a href={g('guide/paratext/')}>The apparatus in Paratext</a> · <a href={g('witnesses/')}>Witnesses</a> · <a href={ex(2, 'list-the-readings')}>Example: John 1:18</a> · Practise: <a href={g('practice/mark-1-2/#step-list')}>Mark 1:2</a>, <a href={g('practice/1-john-5-7/#step-list')}>1 John 5:7–8</a></p>
      </section>

      <section class="step" id="s3">
        <span class="n">Step 3</span>
        <h2>External evidence</h2>
        <p class="ask">Ask the six questions about the witnesses. Number comes last.</p>
        <div class="qs">
          {EXTERNAL.map(([k, q, h]) => (
            <div class="q">
              <div><b>{q}</b> <span class="small muted">{h}</span></div>
              <Fragment set:html={favours(`issue.external.${k}.favours`, q)} />
              <textarea name={`issue.external.${k}.note`} data-sigla rows="1" dir="auto" aria-label={`${q} notes`}></textarea>
            </div>
          ))}
        </div>
        <p class="see small">See: <a href={g('guide/weighing-evidence/')}>Weighing the evidence</a> · <a href={ex(3, 'external-evidence')}>Example: John 1:18</a> · Practise: <a href={g('practice/mark-1-2/#step-external')}>Mark 1:2</a>, <a href={g('practice/1-john-5-7/#step-external')}>1 John 5:7–8</a></p>
      </section>

      <section class="step" id="s4">
        <span class="n">Step 4</span>
        <h2>Internal evidence</h2>
        <p class="ask">What would a scribe do, and what would the author write?</p>
        <div class="qs">
          {INTERNAL.map(([k, q, h]) => (
            <div class="q">
              <div><b>{q}</b> <span class="small muted">{h}</span></div>
              <Fragment set:html={favours(`issue.internal.${k}.favours`, q)} />
              <textarea name={`issue.internal.${k}.note`} data-sigla rows="2" dir="auto" aria-label={`${q} notes`}></textarea>
            </div>
          ))}
        </div>
        <fieldset>
          <legend>Rules of thumb you used</legend>
          {RULES.map(([k, l]) => <label class="check"><input type="checkbox" name={`issue.internal.rules.${k}`} /><span>{l}</span></label>)}
          <p class="small muted">Each rule is a guide, not a law. Say which rule you use and why.</p>
        </fieldset>
        <p class="see small">See: <a href={g('guide/weighing-evidence/')}>Weighing the evidence</a> · <a href={ex(4, 'internal-evidence')}>Example: John 1:18</a> · Practise: <a href={g('practice/mark-1-2/#step-internal')}>Mark 1:2</a>, <a href={g('practice/1-john-5-7/#step-internal')}>1 John 5:7–8</a></p>
      </section>

      <section class="step" id="s5">
        <span class="n">Step 5</span>
        <h2>Weigh it up</h2>
        <p class="ask">Which reading came first, and how sure can we be?</p>
        <div class="grid">
          <label>The reading that came first<select name="issue.weigh.original" data-favours data-plain><option value="">Choose…</option><option value="unclear">Cannot decide</option></select></label>
          <label>How sure are you?
            <select name="issue.weigh.confidence">
              <option value="">Choose…</option><option value="sure">Sure</option><option value="fairly-sure">Fairly sure</option><option value="unsure">Unsure</option>
            </select>
          </label>
        </div>
        <label>Your reasons<textarea name="issue.weigh.reasons" data-sigla rows="3" dir="auto" placeholder="Put the external and internal evidence together. Compare the UBS rating."></textarea></label>
        <p class="see small">See: <a href={g('guide/apparatus/#ratings')}>What the ratings tell you</a> · <a href={ex(5, 'weigh-it-up')}>Example: John 1:18</a> · Practise: <a href={g('practice/mark-1-2/#step-weigh')}>Mark 1:2</a>, <a href={g('practice/1-john-5-7/#step-weigh')}>1 John 5:7–8</a></p>
      </section>

      <section class="step" id="s6">
        <span class="n">Step 6</span>
        <h2>Decide for your translation</h2>
        <p class="ask">What will you print, and what will you tell your readers?</p>
        <p class="small muted">Your project's text policy comes first. A decision here is a recommendation: your Review Committee decides.</p>
        <label>What the UBS text prints<textarea name="issue.decide.ubs" rows="2" dir="auto"></textarea></label>
        <label>How your Bible handles it<textarea name="issue.decide.yourBible" rows="2" dir="auto" placeholder="Which reading does it follow? Brackets, footnote?"></textarea></label>
        <label>Translation options<textarea name="issue.decide.options" rows="3" dir="auto" placeholder="Ways you could render each reading in your language."></textarea></label>
        <fieldset>
          <legend>Suggested actions</legend>
          <div class="acts">
            {ACTIONS.map(([k, l]) => <label class="check"><input type="checkbox" name={`issue.decide.actions.${k}`} /><span>{l}</span></label>)}
          </div>
        </fieldset>
        <label class="verdict">Verdict<textarea name="issue.decide.verdict" rows="3" dir="auto" placeholder="What you will print, and why."></textarea></label>
        <label>Draft footnote<textarea name="issue.decide.footnote" rows="2" dir="auto" placeholder="e.g. Some manuscripts have …"></textarea></label>
        <p class="see small">See: <a href={g('guide/text-policy/')}>Which text should a translation follow?</a> · <a href={g('guide/footnotes/')}>Writing textual footnotes</a> · <a href={ex(6, 'decide-for-your-translation')}>Example: John 1:18</a> · Practise: <a href={g('practice/mark-1-2/#step-decide')}>Mark 1:2</a>, <a href={g('practice/1-john-5-7/#step-decide')}>1 John 5:7–8</a></p>
      </section>
    </form>

    <template id="reading-tpl">
      <li class="reading">
        <div class="r-head"><b class="r-label"></b><button type="button" class="r-del no-print">Remove</button></div>
        <div class="grid">
          <label>Reading (Greek or other)<input data-f="text" dir="auto" lang="grc" /></label>
          <label>Meaning in your language<input data-f="gloss" dir="auto" /></label>
        </div>
        <label>Who supports it<textarea data-f="support" data-sigla rows="2" placeholder="e.g. 𝔓⁶⁶ 𝔓⁷⁵ א* B"></textarea></label>
        <label class="check"><input type="checkbox" data-f="inUbsText" /><span>This is the reading the UBS text prints</span></label>
      </li>
    </template>

    <div class="wb-keys no-print" id="sigla-keys" hidden role="group" aria-label="Siglum symbols">
      <p class="small muted">Tap a symbol, or type <kbd>P66</kbd>, <kbd>aleph</kbd>, <kbd>theta</kbd>, <kbd>f13</kbd>: they change to 𝔓⁶⁶, א, Θ, ƒ¹³ when you leave the box. Tap <b>x²</b> to type small raised numbers.</p>
      <div class="krow">
        {['𝔓', 'א', 'ƒ', 'ℓ', '*', 'ᶜ', 'ᵛⁱᵈ', 'ˢᵘᵖᵖ', 'Byz', 'Lect'].map((k) => <button type="button" data-k={k}>{k}</button>)}
        <button type="button" data-sup aria-pressed="false" title="Raised numbers on or off">x²</button>
      </div>
      <div class="krow">
        {['Γ', 'Δ', 'Θ', 'Λ', 'Ξ', 'Π', 'Σ', 'Φ', 'Ψ', 'Ω', '⟦', '⟧', '♦'].map((k) => <button type="button" data-k={k}>{k}</button>)}
      </div>
      <div class="krow sup" hidden>
        {['¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹', '⁰'].map((k) => <button type="button" data-k={k}>{k}</button>)}
      </div>
    </div>
  </div>
</Base>

<script define:vars={{ sw: url('workbench/sw.js'), scope: url('workbench/') }}>
  window.__wbSw = { sw, scope };
</script>
<script>
  // Data lives in one object; form fields are named by their JSON path.
  const KEY = 'tc-workbench';
  const SCHEMA = 'tc-workbench/1';
  type Reading = { label: string; text: string; gloss: string; support: string; inUbsText: boolean };
  type Doc = { schema: string; saved: string; about: Record<string, string>; issue: any };

  const form = document.getElementById('wb') as HTMLFormElement;
  const list = document.getElementById('readings') as HTMLOListElement;
  const tpl = document.getElementById('reading-tpl') as HTMLTemplateElement;
  const status = document.getElementById('wb-status')!;
  const LABELS = 'ABCDEFGHIJ';

  const blank = (about: Record<string, string> = {}): Doc => ({
    schema: SCHEMA, saved: '', about,
    issue: { readings: [{ text: '', gloss: '', support: '', inUbsText: true }, { text: '', gloss: '', support: '', inUbsText: false }] },
  });

  const get = (o: any, path: string) => path.split('.').reduce((a, k) => (a == null ? undefined : a[k]), o);
  const set = (o: any, path: string, v: unknown) => {
    const ks = path.split('.'); let a = o;
    ks.slice(0, -1).forEach((k) => (a = a[k] ??= {}));
    a[ks[ks.length - 1]] = v;
  };

  function readings(): Reading[] {
    return [...list.children].map((li, i) => {
      const f = (n: string) => li.querySelector<HTMLInputElement>(`[data-f="${n}"]`)!;
      return { label: LABELS[i], text: f('text').value, gloss: f('gloss').value, support: f('support').value, inUbsText: f('inUbsText').checked };
    });
  }

  function collect(): Doc {
    const d = blank(); d.issue = {};
    for (const el of form.elements as any as HTMLInputElement[]) {
      if (!el.name) continue;
      set(d, el.name, el.type === 'checkbox' ? el.checked : el.value);
    }
    d.issue.readings = readings();
    d.saved = new Date().toISOString();
    return d;
  }

  function addReading(r?: Partial<Reading>) {
    const li = (tpl.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLLIElement;
    list.append(li);
    const f = (n: string) => li.querySelector<HTMLInputElement>(`[data-f="${n}"]`)!;
    f('text').value = r?.text ?? ''; f('gloss').value = r?.gloss ?? ''; f('support').value = r?.support ?? '';
    f('inUbsText').checked = !!r?.inUbsText;
    li.querySelector('.r-del')!.addEventListener('click', () => {
      if (list.children.length < 2) return;
      // Letters shift after a removal: B becomes A, and so on. Move the choices with them.
      const gone = [...list.children].indexOf(li);
      document.querySelectorAll<HTMLSelectElement>('select[data-favours]').forEach((sel) => {
        const i = LABELS.indexOf(sel.value);
        if (!sel.value || i < 0) return;
        if (i === gone) sel.value = ''; else if (i > gone) sel.dataset.next = LABELS[i - 1];
      });
      li.remove(); relabel();
      document.querySelectorAll<HTMLSelectElement>('select[data-next]').forEach((sel) => { sel.value = sel.dataset.next!; delete sel.dataset.next; });
      save();
    });
    li.querySelectorAll('textarea').forEach(grow);
  }

  // Reading letters, and the "favours" lists that name them.
  function relabel() {
    [...list.children].forEach((li, i) => { li.querySelector('.r-label')!.textContent = `Reading ${LABELS[i]}`; });
    const n = list.children.length;
    document.querySelectorAll<HTMLSelectElement>('select[data-favours]').forEach((s) => {
      const keep = s.value;
      s.querySelectorAll('option[data-r]').forEach((o) => o.remove());
      const first = s.options[0];
      for (let i = n - 1; i >= 0; i--) {
        const o = new Option(`Reading ${LABELS[i]}`, LABELS[i]); o.dataset.r = '1';
        first.after(o);
      }
      s.value = keep;
    });
  }

  function valid(d: any): d is Doc {
    const obj = (x: unknown) => !!x && typeof x === 'object' && !Array.isArray(x);
    if (!obj(d) || d.schema !== SCHEMA || !obj(d.issue) || (d.about !== undefined && !obj(d.about))) return false;
    const rs = d.issue.readings;
    return rs === undefined || (Array.isArray(rs) && rs.length <= LABELS.length && rs.every(obj));
  }

  function fill(d: Doc) {
    list.replaceChildren();
    const rs: Reading[] = d.issue?.readings?.length ? d.issue.readings : blank().issue.readings;
    rs.forEach(addReading);
    relabel();
    for (const el of form.elements as any as HTMLInputElement[]) {
      if (!el.name) continue;
      const v = get(d, el.name);
      if (el.type === 'checkbox') el.checked = !!v; else el.value = v ?? '';
    }
    form.querySelectorAll('textarea').forEach(grow);
  }

  function grow(t: HTMLTextAreaElement) { t.style.height = 'auto'; t.style.height = t.scrollHeight + 2 + 'px'; }

  let timer = 0;
  function save() {
    try { localStorage.setItem(KEY, JSON.stringify(collect())); say('Saved in this browser.'); }
    catch { say('Could not save in this browser. Download a file to keep your work.'); }
  }
  function say(t: string) { status.textContent = t; }

  form.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t instanceof HTMLTextAreaElement) grow(t);
    clearTimeout(timer); timer = window.setTimeout(save, 400);
  });
  form.addEventListener('change', save);
  document.getElementById('add-reading')!.addEventListener('click', () => {
    if (list.children.length >= LABELS.length) return;
    addReading(); relabel(); save();
    (list.lastElementChild!.querySelector('input') as HTMLInputElement).focus();
  });

  function fileName(d: Doc) {
    const ref = (d.issue.reference || 'issue').normalize('NFKD').replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '').toLowerCase();
    return `${ref || 'issue'}_${d.saved.slice(0, 10)}.json`;
  }

  document.getElementById('wb-download')!.addEventListener('click', () => {
    const d = collect();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([JSON.stringify(d, null, 2)], { type: 'application/json' }));
    a.download = fileName(d);
    document.body.append(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    say(`Downloaded ${a.download}.`);
  });

  document.getElementById('wb-open')!.addEventListener('change', async (e) => {
    const inp = e.target as HTMLInputElement; const file = inp.files?.[0]; inp.value = '';
    if (!file) return;
    try {
      const d = JSON.parse(await file.text());
      if (!valid(d)) throw new Error('not a workbench file');
      if (!confirm('Replace what is on the page with this file?')) return;
      const before = collect();
      try { fill(d); } catch (err) { fill(before); throw err; }
      save(); say(`Opened ${file.name}.`);
    } catch { say(`${file.name} is not a workbench file.`); }
  });

  document.getElementById('wb-new')!.addEventListener('click', () => {
    if (!confirm('Start a new issue? Download this one first if you want to keep it. Your "About this work" stays.')) return;
    fill(blank(collect().about)); save(); window.scrollTo(0, 0);
  });
  document.getElementById('wb-print')!.addEventListener('click', () => { (document.getElementById('about') as HTMLDetailsElement).open = true; print(); });
  addEventListener('beforeprint', () => { (document.getElementById('about') as HTMLDetailsElement).open = true; form.querySelectorAll('textarea').forEach(grow); });

  let start = blank();
  try { const s = localStorage.getItem(KEY); if (s) start = JSON.parse(s); } catch {}
  fill(start);
  if (start.saved) say('Your last work is back from this browser.');

  // Siglum help: a keypad under the focused "who supports it" box, and P66 -> 𝔓⁶⁶ when leaving it.
  const keys = document.getElementById('sigla-keys')!;
  const supRow = keys.querySelector<HTMLElement>('.sup')!;
  const supBtn = keys.querySelector<HTMLButtonElement>('[data-sup]')!;
  const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';
  const GREEK: Record<string, string> = { gamma: 'Γ', delta: 'Δ', theta: 'Θ', lambda: 'Λ', xi: 'Ξ', pi: 'Π', sigma: 'Σ', phi: 'Φ', psi: 'Ψ', omega: 'Ω' };
  const sup = (d: string) => [...d].map((c) => SUP[+c]).join('');
  let target: HTMLTextAreaElement | null = null;
  const tidy = (s: string) => s
    .replace(/(^|[\s,;(])[Pp𝔓]\s?(\d+)(?=$|[\s,;)*])/gu, (_, a, d) => a + '𝔓' + sup(d))
    .replace(/(^|[\s,;(])(?:aleph|alef|ℵ)(?=$|[\s,;)*\d²¹³⁰-⁹])/giu, '$1א')
    .replace(/(^|[\s,;(])(gamma|delta|theta|lambda|xi|pi|sigma|phi|psi|omega)(?=$|[\s,;)*])/giu, (_, a, w) => a + GREEK[w.toLowerCase()])

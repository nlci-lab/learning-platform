---
// The course's page shell: the platform layout with this course's config and its own styles
// (sigla, Hebrew, witness tiles, coverage bars, search). Pages keep importing this file.
import PlatformBase from '@cohorts/platform/layouts/Base.astro';
import '../styles/course.css';
import { course } from '../course.config';
interface Props { title: string; description?: string; nav?: string }
const { title, description, nav } = Astro.props;
---
<PlatformBase site={course} title={title} description={description} nav={nav}>
  <Fragment slot="head">
    {/* Only the letter א, for sigla. display=optional: no font swap flash; slow connections keep the system font. */}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+Hebrew&text=%D7%90&display=optional" />
  </Fragment>
  <slot />
</PlatformBase>
